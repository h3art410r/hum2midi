# Stable Audio 3 local TFLite checkout. By default the app looks for the
# sibling checkout ../stable-audio-3-local/optimized/tflite.
STABLE_AUDIO_ROOT=
STABLE_AUDIO_MODEL=sm-music
STABLE_AUDIO_DECODER=same-s
STABLE_AUDIO_STEPS=8
STABLE_AUDIO_THREADS=8
# Higher noise makes a bigger stylistic change but can erase the melody;
# input duration normally overrides OUTPUT_SECONDS for each job.
STABLE_AUDIO_INIT_NOISE_LEVEL=0.70
STABLE_AUDIO_SEED=101
STABLE_AUDIO_OUTPUT_SECONDS=10
STABLE_AUDIO_TIMEOUT_SECONDS=600

# Optional remote DiffSynth-Music Prosody worker on the Windows/CUDA machine.
# This is explicit: the app never silently falls back between providers.
H2M_AUDIO_PROVIDER=stable_audio
DIFFSYNTH_REMOTE_URL=http://127.0.0.1:8765
DIFFSYNTH_REMOTE_TIMEOUT_SECONDS=900
DIFFSYNTH_REMOTE_TOKEN=

# Upload and temporary job storage.
MAX_UPLOAD_MB=10
H2M_DATA_DIR=data/demo

# Native DiffSynth-Music backend (new clean version).
# The backend never loads the GPU model; it calls the resident Worker.
NATIVE_WORKER_URL=http://127.0.0.1:8765
NATIVE_WORKER_TIMEOUT_SECONDS=900
NATIVE_WORKER_TOKEN=
NATIVE_DATA_DIR=runtime/native_jobs
NATIVE_SEED=42
NATIVE_CFG_SCALE=4
NATIVE_STEPS=50
