DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_BASE_URL=
QWEN_OMNI_MODEL=qwen3.5-omni-flash
# Transcription engine: dsp (default), klangio (cloud vocal model), or auto.
TRANSCRIPTION_ENGINE=dsp
KLANGIO_API_KEY=
KLANGIO_BASE_URL=https://api.klang.io
KLANGIO_MODEL=vocal
KLANGIO_TIMEOUT_SECONDS=120
KLANGIO_POLL_SECONDS=2
QWEN_TEXT_MODEL=qwen-flash
QWEN_TEXT_MAX_TOKENS=3072
QWEN_TEXT_TEMPERATURE=0.85
MAX_UPLOAD_MB=10
# MIDI audio backend: auto (prefer FluidSynth when installed) or procedural.
AUDIO_RENDERER=auto
# Optional absolute paths; auto also checks data/fluidsynth and data/soundfonts.
FLUIDSYNTH_BIN=
SOUNDFONT_PATH=
FLUIDSYNTH_TIMEOUT_SECONDS=45
# Reproducible performance variation for backing parts; change for A/B takes.
H2M_PERFORMANCE_SEED=17

